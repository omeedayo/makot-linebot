{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/line_webhook", "dest": "app.py" },
    { "src": "/push/monday", "dest": "app.py" },
    { "src": "/push/friday", "dest": "app.py" },
    { "src": "/(.*)",        "dest": "app.py" }
  ],
  "crons": [
    {
      "path": "/push/monday",
      // テスト用に UTC 12:40 (JST 21:40) に設定します。曜日は指定しません(*)
      "schedule": "40 12 * * *"
    },
    {
      "path": "/push/friday",
      // こちらはテストしないのでそのままにしておきます
      "schedule": "0 12 * * 5"
    }
  ]
}
