{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "build": "pip install --no-cache-dir --force-reinstall -r requirements.txt"
      }
    }
  ],
  "routes": [
    { "src": "/line_webhook", "dest": "app.py" },
    { "src": "/(.*)", "dest": "app.py" }
  ],
  "crons": [
    {
      "path": "/cron/send_weekly_message?day=monday",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/cron/send_weekly_message?day=friday",
      "schedule": "0 12 * * 5"
    }
  ]
}
