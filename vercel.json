{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/line_webhook", "dest": "app.py" },
    { "src": "/push/monday", "dest": "app.py" },
    { "src": "/push/friday", "dest": "app.py" },
    { "src": "/(.*)",        "dest": "app.py" }
  ],
  "crons": [
    {
      "path": "/push/monday",
      "schedule": "10 13 * * *"  
    },
    {
      "path": "/push/friday",
      "schedule": "0 12 * * 5"
    }
  ]
}
